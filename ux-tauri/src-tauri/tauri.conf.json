{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTabletDriver",
  "version": "0.6.7",
  "identifier": "net.opentabletdriver.ux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenTabletDriver",
        "width": 1360,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/OpenTabletDriver.Daemon",
      "binaries/OpenTabletDriver.BleBridge",
      "binaries/OpenTabletDriver.WheelModeOverlay",
      "binaries/OpenTabletDriver.DisplaySwapOverlay"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
