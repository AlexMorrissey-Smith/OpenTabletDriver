{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTabletDriver",
  "version": "0.1.0",
  "identifier": "net.opentabletdriver.ux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenTabletDriver",
        "width": 1180,
        "height": 840,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/OpenTabletDriver.Daemon",
      "binaries/OpenTabletDriver.BleBridge",
      "binaries/OpenTabletDriver.WheelModeOverlay",
      "binaries/OpenTabletDriver.DisplaySwapOverlay"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
